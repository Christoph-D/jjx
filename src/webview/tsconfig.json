{
  "compilerOptions": {
    "module": "Preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "sourceMap": true,
    "strict": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    /* The split view shares src/split/hunk-model.ts with the extension host, which uses Node's Buffer */
    "types": ["node"],
    "rootDirs": ["./graph", "./graph/.generated", "./split"],
    "plugins": [{ "name": "typescript-plugin-css-modules" }]
  },
  "include": ["graph/**/*", "split/**/*", "../graph-protocol.ts", "../split-protocol.ts"],
  "exclude": ["node_modules", "dist"]
}
