{
  "name": "jjx",
  "displayName": "Jujutsu X",
  "publisher": "jjx",
  "description": "First-class VS Code integration for Jujutsu (jj) with visual history and fluid workflows",
  "icon": "images/logo.png",
  "version": "1.11.0",
  "engines": {
    "vscode": "^1.110.0",
    "node": ">=20"
  },
  "categories": [
    "SCM Providers"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Christoph-D/jjx.git"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/main.js",
  "contributes": {
    "views": {
      "scm": [
        {
          "type": "webview",
          "id": "jjGraphWebview",
          "name": "JJ Graph",
          "when": "jj.reposExist"
        },
        {
          "id": "jjOperationLog",
          "name": "JJ Operation Log",
          "when": "jj.reposExist"
        }
      ]
    },
    "commands": [
      {
        "command": "jj.refresh",
        "title": "Refresh",
        "category": "Jujutsu",
        "icon": "$(refresh)",
        "enablement": "!operationInProgress"
      },
      {
        "command": "jj.openFileResourceState",
        "title": "Open File",
        "category": "Jujutsu",
        "icon": "$(go-to-file)"
      },
      {
        "command": "jj.openFileAtRevision",
        "title": "Open File",
        "category": "Jujutsu",
        "icon": "$(eye)"
      },
      {
        "command": "jj.toggleDiffView",
        "title": "Toggle Diff View",
        "category": "Jujutsu",
        "icon": "$(compare-changes)"
      },
      {
        "command": "jj.openDiffResourceState",
        "title": "View as Diff",
        "category": "Jujutsu",
        "icon": "$(compare-changes)"
      },
      {
        "command": "jj.openFileInWorkingCopyEditor",
        "title": "Open File in Working Copy",
        "category": "Jujutsu",
        "icon": "$(go-to-file)"
      },
      {
        "command": "jj.openFileInWorkingCopyResourceState",
        "title": "Open File in Working Copy",
        "category": "Jujutsu",
        "icon": "$(go-to-file)"
      },
      {
        "command": "jj.describe",
        "title": "Update Change Description",
        "category": "Jujutsu",
        "icon": "$(edit)"
      },
      {
        "command": "jj.new",
        "title": "Create New Change",
        "category": "Jujutsu",
        "icon": "$(plus)"
      },
      {
        "command": "jj.newWithEditor",
        "title": "Create New Change with Editor",
        "category": "Jujutsu"
      },
      {
        "command": "jj.squashToParentResourceGroup",
        "title": "Move Changes to Parent",
        "category": "Jujutsu",
        "icon": "$(arrow-down)"
      },
      {
        "command": "jj.squashToWorkingCopyResourceGroup",
        "title": "Move Changes to Working Copy",
        "category": "Jujutsu",
        "icon": "$(arrow-up)"
      },
      {
        "command": "jj.squashToParentResourceState",
        "title": "Move Changes to Parent",
        "category": "Jujutsu",
        "icon": "$(arrow-down)"
      },
      {
        "command": "jj.squashToWorkingCopyResourceState",
        "title": "Move Changes to Working Copy",
        "category": "Jujutsu",
        "icon": "$(arrow-up)"
      },
      {
        "command": "jj.editResourceGroup",
        "title": "Edit This Change",
        "category": "Jujutsu",
        "icon": "$(sign-in)"
      },
      {
        "command": "jj.viewInterdiff",
        "title": "View Interdiff",
        "category": "Jujutsu",
        "icon": "$(compare-changes)"
      },
      {
        "command": "jj.viewRegularDiff",
        "title": "View Regular Diff",
        "category": "Jujutsu",
        "icon": "$(diff)"
      },
      {
        "command": "jj.restoreResourceState",
        "title": "Discard Changes",
        "category": "Jujutsu",
        "icon": "$(discard)"
      },
      {
        "command": "jj.restoreResourceGroup",
        "title": "Discard Changes",
        "category": "Jujutsu",
        "icon": "$(discard)"
      },
      {
        "command": "jj.gitFetch",
        "title": "Fetch from Default Remote",
        "category": "Jujutsu",
        "icon": "$(cloud-download)"
      },
      {
        "command": "jj.gitFetch.syncing",
        "title": "Fetching from Default Remote...",
        "category": "Jujutsu",
        "icon": "$(sync~spin)"
      },
      {
        "command": "jj.refreshOperationLog",
        "title": "Refresh Operation Log",
        "category": "Jujutsu",
        "icon": "$(refresh)"
      },
      {
        "command": "jj.selectOperationLogRepo",
        "title": "Select Repository",
        "category": "Jujutsu",
        "icon": "$(repo)"
      },
      {
        "command": "jj.undo",
        "title": "Undo",
        "category": "Jujutsu",
        "icon": "$(discard)"
      },
      {
        "command": "jj.redo",
        "title": "Redo",
        "category": "Jujutsu",
        "icon": "$(redo)"
      },
      {
        "command": "jj.operationRevert",
        "title": "Revert Operation",
        "category": "Jujutsu",
        "icon": "$(discard)"
      },
      {
        "command": "jj.operationRestore",
        "title": "Restore Repo to the State at This Operation",
        "category": "Jujutsu",
        "icon": "$(history)"
      },
      {
        "command": "jj.refreshGraphWebview",
        "title": "Refresh JJ Graph",
        "category": "Jujutsu",
        "icon": "$(refresh)"
      },
      {
        "command": "jj.toggleElideImmutableCommits.show",
        "title": "Show Elided Commits",
        "category": "Jujutsu",
        "icon": "$(unfold)"
      },
      {
        "command": "jj.toggleElideImmutableCommits.elide",
        "title": "Elide Immutable Commits",
        "category": "Jujutsu",
        "icon": "$(fold)"
      },
      {
        "command": "jj.newGraphWebview",
        "title": "Create New Change with Selected as Parents",
        "category": "Jujutsu",
        "icon": "$(plus)"
      },
      {
        "command": "jj.selectGraphWebviewRepo",
        "title": "Select Repository",
        "category": "Jujutsu",
        "icon": "$(repo)"
      },
      {
        "command": "jj.placeholderForFolders",
        "title": "​",
        "category": "Jujutsu",
        "enablement": "false"
      },
      {
        "command": "jj.squashSelectedRanges",
        "title": "Squash Selected Changes...",
        "category": "Jujutsu"
      },
      {
        "command": "jj.openParentChange",
        "title": "Open Parent Change",
        "category": "Jujutsu",
        "icon": "$(arrow-left)"
      },
      {
        "command": "jj.openChildChange",
        "title": "Open Child Change",
        "category": "Jujutsu",
        "icon": "$(arrow-right)"
      },
      {
        "command": "jj.copyPath",
        "title": "Copy Path",
        "category": "Jujutsu"
      },
      {
        "command": "jj.copyRelativePath",
        "title": "Copy Relative Path",
        "category": "Jujutsu"
      },
      {
        "command": "jj.trackUntrackedFile",
        "title": "Track This File",
        "category": "Jujutsu",
        "icon": "$(plus)"
      },
      {
        "command": "jj.deleteUntrackedFile",
        "title": "Delete This File",
        "category": "Jujutsu",
        "icon": "$(trash)"
      },
      {
        "command": "jj.trackAllUntrackedFiles",
        "title": "Track All Untracked Files",
        "category": "Jujutsu",
        "icon": "$(plus)"
      },
      {
        "command": "jj.deleteAllUntrackedFiles",
        "title": "Delete All Untracked Files",
        "category": "Jujutsu",
        "icon": "$(trash)"
      },
      {
        "command": "jj.gitFetchAllRemotes",
        "title": "Fetch from All Remotes",
        "category": "Jujutsu",
        "icon": "$(cloud-download)"
      },
      {
        "command": "jj.gitFetchFromRemote",
        "title": "Fetch from Selected Remote...",
        "category": "Jujutsu",
        "icon": "$(repo-fetch)"
      }
    ],
    "submenus": [
      {
        "id": "jj.graphFetchSubmenu",
        "label": "Fetch...",
        "icon": "$(ellipsis)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "jj.squashSelectedRanges",
          "when": "jj.reposExist && editorTextFocus && editorHasSelection && !editorReadonly"
        },
        {
          "command": "jj.toggleDiffView",
          "when": "jj.reposExist && !jj.comparisonDiffActive",
          "group": "navigation@1"
        },
        {
          "command": "jj.openFileInWorkingCopyEditor",
          "when": "jj.reposExist && resourceScheme == jj",
          "group": "navigation@2"
        },
        {
          "command": "jj.openParentChange",
          "when": "jj.reposExist",
          "group": "navigation@2"
        },
        {
          "command": "jj.openChildChange",
          "when": "jj.reposExist",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "jj.squashSelectedRanges",
          "when": "jj.reposExist && editorTextFocus && editorHasSelection && !editorReadonly"
        }
      ],
      "view/title": [
        {
          "command": "jj.undo",
          "when": "view == jjOperationLog",
          "group": "navigation@1"
        },
        {
          "command": "jj.redo",
          "when": "view == jjOperationLog",
          "group": "navigation@2"
        },
        {
          "command": "jj.refreshOperationLog",
          "when": "view == jjOperationLog",
          "group": "navigation@3"
        },
        {
          "command": "jj.selectOperationLogRepo",
          "when": "view == jjOperationLog && jj.hasMultipleRepos",
          "group": "navigation@4"
        },
        {
          "command": "jj.gitFetch",
          "when": "view == jjGraphWebview && !jj.fetching",
          "group": "navigation@0"
        },
        {
          "command": "jj.gitFetch.syncing",
          "when": "view == jjGraphWebview && jj.fetching",
          "group": "navigation@0"
        },
        {
          "command": "jj.undo",
          "when": "view == jjGraphWebview",
          "group": "navigation@1"
        },
        {
          "command": "jj.redo",
          "when": "view == jjGraphWebview",
          "group": "navigation@2"
        },
        {
          "command": "jj.refreshGraphWebview",
          "when": "view == jjGraphWebview",
          "group": "navigation@3"
        },
        {
          "command": "jj.newGraphWebview",
          "when": "view == jjGraphWebview && jjGraphView.nodesSelected",
          "group": "navigation@4"
        },
        {
          "command": "jj.toggleElideImmutableCommits.show",
          "when": "view == jjGraphWebview && jjGraphView.elidingActive",
          "group": "navigation@5"
        },
        {
          "command": "jj.toggleElideImmutableCommits.elide",
          "when": "view == jjGraphWebview && !jjGraphView.elidingActive",
          "group": "navigation@5"
        },
        {
          "command": "jj.selectGraphWebviewRepo",
          "when": "view == jjGraphWebview && jj.hasMultipleRepos",
          "group": "navigation@6"
        },
        {
          "submenu": "jj.graphFetchSubmenu",
          "when": "view == jjGraphWebview",
          "group": "navigation@7"
        }
      ],
      "jj.graphFetchSubmenu": [
        {
          "command": "jj.gitFetchAllRemotes",
          "when": "view == jjGraphWebview",
          "group": "1_fetch@1"
        },
        {
          "command": "jj.gitFetchFromRemote",
          "when": "view == jjGraphWebview",
          "group": "1_fetch@2"
        }
      ],
      "view/item/context": [
        {
          "command": "jj.operationRevert",
          "when": "view == jjOperationLog",
          "group": "inline"
        },
        {
          "command": "jj.operationRestore",
          "when": "view == jjOperationLog",
          "group": "inline"
        }
      ],
      "scm/title": [
        {
          "command": "jj.refresh",
          "when": "scmProvider == jj && jj.jjBinaryFound",
          "group": "navigation"
        },
        {
          "command": "jj.new",
          "when": "scmProvider == jj && jj.jjBinaryFound",
          "group": "navigation"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "jj.squashToParentResourceGroup",
          "when": "scmProvider == jj && scmResourceGroup == @ && jj.jjBinaryFound",
          "group": "inline"
        },
        {
          "command": "jj.squashToWorkingCopyResourceGroup",
          "when": "scmProvider == jj && scmResourceGroup != @ && scmResourceGroup != selected && scmResourceGroup != diff && scmResourceGroup != interdiff && scmResourceGroup != untracked && jj.jjBinaryFound",
          "group": "inline"
        },
        {
          "command": "jj.restoreResourceGroup",
          "when": "scmProvider == jj && scmResourceGroup != selected && scmResourceGroup != diff && scmResourceGroup != interdiff && scmResourceGroup != untracked && jj.jjBinaryFound",
          "group": "inline"
        },
        {
          "command": "jj.editResourceGroup",
          "when": "scmProvider == jj && scmResourceGroup != @ && scmResourceGroup != diff && scmResourceGroup != interdiff && scmResourceGroup != untracked && jj.jjBinaryFound",
          "group": "inline"
        },
        {
          "command": "jj.describe",
          "when": "scmProvider == jj && scmResourceGroup != diff && scmResourceGroup != interdiff && scmResourceGroup != untracked && jj.jjBinaryFound",
          "group": "inline"
        },
        {
          "command": "jj.viewInterdiff",
          "when": "scmProvider == jj && scmResourceGroup == diff && jj.jjBinaryFound",
          "group": "inline"
        },
        {
          "command": "jj.viewRegularDiff",
          "when": "scmProvider == jj && scmResourceGroup == interdiff && jj.jjBinaryFound",
          "group": "inline"
        },
        {
          "command": "jj.trackAllUntrackedFiles",
          "when": "scmProvider == jj && scmResourceGroup == untracked && jj.jjBinaryFound",
          "group": "inline@1"
        },
        {
          "command": "jj.deleteAllUntrackedFiles",
          "when": "scmProvider == jj && scmResourceGroup == untracked && jj.jjBinaryFound",
          "group": "inline@2"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "jj.openDiffResourceState",
          "when": "scmProvider == jj && scmResourceGroup != interdiff && scmResourceGroup != diff && scmResourceGroup != untracked && jj.jjBinaryFound",
          "group": "1_modification@1"
        },
        {
          "command": "jj.openFileAtRevision",
          "when": "scmProvider == jj && scmResourceGroup != interdiff && scmResourceGroup != diff && scmResourceGroup != untracked && jj.jjBinaryFound",
          "group": "1_modification@2"
        },
        {
          "command": "jj.openFileInWorkingCopyResourceState",
          "when": "scmProvider == jj && scmResourceGroup != @ && scmResourceGroup != untracked && jj.jjBinaryFound",
          "group": "1_modification@3"
        },
        {
          "command": "jj.copyPath",
          "when": "scmProvider == jj && scmResourceGroup != untracked && jj.jjBinaryFound",
          "group": "9_copypath@1"
        },
        {
          "command": "jj.copyRelativePath",
          "when": "scmProvider == jj && scmResourceGroup != untracked && jj.jjBinaryFound",
          "group": "9_copypath@2"
        },
        {
          "command": "jj.openFileResourceState",
          "when": "scmProvider == jj && scmResourceGroup == @ && config.jjx.fileClickAction == 'diff' && jj.jjBinaryFound",
          "group": "inline@1"
        },
        {
          "command": "jj.openDiffResourceState",
          "when": "scmProvider == jj && scmResourceGroup == @ && config.jjx.fileClickAction != 'diff' && jj.jjBinaryFound",
          "group": "inline@1"
        },
        {
          "command": "jj.openDiffResourceState",
          "when": "scmProvider == jj && scmResourceGroup != @ && scmResourceGroup != interdiff && scmResourceGroup != diff && scmResourceGroup != untracked && config.jjx.fileClickAction != 'diff' && jj.jjBinaryFound",
          "group": "inline@1"
        },
        {
          "command": "jj.openFileAtRevision",
          "when": "scmProvider == jj && scmResourceGroup != @ && scmResourceGroup != interdiff && scmResourceGroup != diff && scmResourceGroup != untracked && config.jjx.fileClickAction != 'at-revision' && jj.jjBinaryFound",
          "group": "inline@2"
        },
        {
          "command": "jj.openFileInWorkingCopyResourceState",
          "when": "scmProvider == jj && scmResourceGroup != @ && scmResourceGroup != interdiff && scmResourceGroup != diff && scmResourceGroup != untracked && config.jjx.fileClickAction != 'working-copy' && jj.jjBinaryFound",
          "group": "inline@3"
        },
        {
          "command": "jj.restoreResourceState",
          "when": "scmProvider == jj && scmResourceGroup != selected && scmResourceGroup != interdiff && scmResourceGroup != diff && scmResourceGroup != untracked && jj.jjBinaryFound",
          "group": "inline@4"
        },
        {
          "command": "jj.squashToParentResourceState",
          "when": "scmProvider == jj && scmResourceGroup == @ && jj.jjBinaryFound",
          "group": "inline@5"
        },
        {
          "command": "jj.squashToWorkingCopyResourceState",
          "when": "scmProvider == jj && scmResourceGroup != @ && scmResourceGroup != selected && scmResourceGroup != interdiff && scmResourceGroup != diff && scmResourceGroup != untracked && jj.jjBinaryFound",
          "group": "inline@5"
        },
        {
          "command": "jj.openFileInWorkingCopyResourceState",
          "when": "scmProvider == jj && scmResourceGroup == untracked && jj.jjBinaryFound",
          "group": "1_modification@1"
        },
        {
          "command": "jj.copyPath",
          "when": "scmProvider == jj && scmResourceGroup == untracked && jj.jjBinaryFound",
          "group": "9_copypath@1"
        },
        {
          "command": "jj.copyRelativePath",
          "when": "scmProvider == jj && scmResourceGroup == untracked && jj.jjBinaryFound",
          "group": "9_copypath@2"
        },
        {
          "command": "jj.trackUntrackedFile",
          "when": "scmProvider == jj && scmResourceGroup == untracked && jj.jjBinaryFound",
          "group": "inline@1"
        },
        {
          "command": "jj.deleteUntrackedFile",
          "when": "scmProvider == jj && scmResourceGroup == untracked && jj.jjBinaryFound",
          "group": "inline@2"
        }
      ],
      "scm/resourceFolder/context": [
        {
          "command": "jj.restoreResourceState",
          "when": "scmProvider == jj && scmResourceGroup != selected && scmResourceGroup != untracked && jj.jjBinaryFound",
          "group": "inline@4"
        },
        {
          "command": "jj.squashToParentResourceState",
          "when": "scmProvider == jj && scmResourceGroup == @ && jj.jjBinaryFound",
          "group": "inline@5"
        },
        {
          "command": "jj.squashToWorkingCopyResourceState",
          "when": "scmProvider == jj && scmResourceGroup != @ && scmResourceGroup != selected && scmResourceGroup != untracked && jj.jjBinaryFound",
          "group": "inline@5"
        }
      ],
      "commandPalette": [
        {
          "command": "jj.openFileResourceState",
          "when": "false"
        },
        {
          "command": "jj.openFileAtRevision",
          "when": "false"
        },
        {
          "command": "jj.openFileInWorkingCopyEditor",
          "when": "false"
        },
        {
          "command": "jj.openFileInWorkingCopyResourceState",
          "when": "false"
        },
        {
          "command": "jj.openDiffResourceState",
          "when": "false"
        },
        {
          "command": "jj.describe",
          "when": "false"
        },
        {
          "command": "jj.squashToParentResourceGroup",
          "when": "false"
        },
        {
          "command": "jj.squashToWorkingCopyResourceGroup",
          "when": "false"
        },
        {
          "command": "jj.squashToParentResourceState",
          "when": "false"
        },
        {
          "command": "jj.squashToWorkingCopyResourceState",
          "when": "false"
        },
        {
          "command": "jj.editResourceGroup",
          "when": "false"
        },
        {
          "command": "jj.viewInterdiff",
          "when": "false"
        },
        {
          "command": "jj.viewRegularDiff",
          "when": "false"
        },
        {
          "command": "jj.restoreResourceState",
          "when": "false"
        },
        {
          "command": "jj.restoreResourceGroup",
          "when": "false"
        },
        {
          "command": "jj.selectOperationLogRepo",
          "when": "false"
        },
        {
          "command": "jj.operationRevert",
          "when": "false"
        },
        {
          "command": "jj.operationRestore",
          "when": "false"
        },
        {
          "command": "jj.selectGraphWebviewRepo",
          "when": "false"
        },
        {
          "command": "jj.placeholderForFolders",
          "when": "false"
        },
        {
          "command": "jj.openParentChange",
          "when": "false"
        },
        {
          "command": "jj.openChildChange",
          "when": "false"
        },
        {
          "command": "jj.copyPath",
          "when": "false"
        },
        {
          "command": "jj.copyRelativePath",
          "when": "false"
        },
        {
          "command": "jj.trackUntrackedFile",
          "when": "false"
        },
        {
          "command": "jj.deleteUntrackedFile",
          "when": "false"
        },
        {
          "command": "jj.trackAllUntrackedFiles",
          "when": "false"
        },
        {
          "command": "jj.deleteAllUntrackedFiles",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "jj.newWithEditor",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "scmRepository"
      }
    ],
    "configuration": {
      "title": "Jujutsu X",
      "properties": {
        "jjx.enableAnnotations": {
          "type": "boolean",
          "default": true,
          "description": "Enables in-line blame annotations",
          "scope": "resource"
        },
        "jjx.commandTimeout": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "description": "Global timeout in milliseconds for all jj commands. If not set, per-command defaults will be used.",
          "scope": "resource",
          "minimum": 1000
        },
        "jjx.jjPath": {
          "type": "string",
          "default": "",
          "description": "Path to the jj executable. If not set, your PATH and common locations will be searched for a jj executable.",
          "scope": "resource"
        },
        "jjx.changeDoubleClickAction": {
          "type": "string",
          "default": "new",
          "enum": [
            "edit",
            "new"
          ],
          "enumDescriptions": [
            "Edits the change (jj edit)",
            "Creates an empty change on top and switches to it (jj new)"
          ],
          "description": "Action to perform when double-clicking a change in the graph view",
          "scope": "resource"
        },
        "jjx.commitAction": {
          "type": "string",
          "default": "commit",
          "enum": [
            "commit",
            "new"
          ],
          "enumDescriptions": [
            "Commits the current change with the description (jj commit)",
            "Creates a new change on top with the description (jj new)"
          ],
          "description": "Action to perform when pressing Ctrl+Enter in the source control input box",
          "scope": "resource"
        },
        "jjx.graphStyle": {
          "type": "string",
          "default": "compact",
          "enum": [
            "full",
            "compact"
          ],
          "enumDescriptions": [
            "Show full commit details: description, change ID, commit ID, author, and timestamp",
            "Show compact single line: change ID - first line of description - author email"
          ],
          "description": "Display style for commits in the graph view",
          "scope": "resource"
        },
        "jjx.pollIntervalSeconds": {
          "type": "number",
          "default": 30,
          "description": "Interval in seconds between repository polls. Set to 0 to disable polling.",
          "scope": "resource",
          "minimum": 0
        },
        "jjx.fileClickAction": {
          "type": "string",
          "default": "diff",
          "enum": [
            "diff",
            "at-revision",
            "working-copy"
          ],
          "enumDescriptions": [
            "View the diff (comparing to parent)",
            "Open the file at the clicked revision",
            "Open the file in the working copy"
          ],
          "description": "Action when clicking a file in the change view",
          "scope": "resource"
        },
        "jjx.elideImmutableCommits": {
          "type": "boolean",
          "default": true,
          "description": "When enabled, chains of immutable commits between relevant commits are elided (hidden) in the graph view. When disabled, all commits are shown.",
          "scope": "resource"
        },
        "jjx.elidedVisibleImmutableParents": {
          "type": "number",
          "default": 1,
          "description": "Number of immutable parent commits to show in the log when eliding commits.",
          "scope": "resource",
          "minimum": 0
        },
        "jjx.logLimit": {
          "type": "number",
          "default": 500,
          "description": "Maximum number of commits shown in the graph view. Smaller values improve performance, higher values show more history.",
          "scope": "resource",
          "minimum": 1
        },
        "jjx.baseWebURL": {
          "type": "string",
          "default": "",
          "description": "Base URL for the 'Copy URL' feature. When set, this overrides git_web_url() for generating commit URLs (e.g., 'https://github.com/user/repo'). If empty, git_web_url() is used.",
          "scope": "resource"
        },
        "jjx.showTooltips": {
          "type": "boolean",
          "default": true,
          "description": "Show tooltips when hovering over commits in the graph view",
          "scope": "resource"
        },
        "jjx.autoUpdateStaleWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Automatically run 'jj workspace update-stale' when the working copy is stale",
          "scope": "resource"
        },
        "jjx.showChangedFiles": {
          "type": "boolean",
          "default": false,
          "description": "⚠️ Experimental: Show changed files for each commit in the graph (similar to `jj log -s`). Clicking a file opens a diff at that revision.",
          "scope": "resource"
        }
      }
    },
    "configurationDefaults": {
      "files.exclude": {
        "**/.jj": true
      }
    },
